<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.QuestionController"
      spacing="20"
      alignment="CENTER"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <Label fx:id="themeLabel"
           text="How confident are you in ..."
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <HBox spacing="15" alignment="CENTER">
        <Button text="1" prefWidth="50" onAction="#handleDifficulty1" />
        <Button text="2" prefWidth="50" onAction="#handleDifficulty2" />
        <Button text="3" prefWidth="50" onAction="#handleDifficulty3" />
        <Button text="4" prefWidth="50" onAction="#handleDifficulty4" />
    </HBox>
</VBox>
