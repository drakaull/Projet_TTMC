<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:controller="view.NbPlayersChoiceUI"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../application/application.css"
           prefWidth="1920" prefHeight="1080">

    <!-- Background fullscreen -->
    <ImageView fitWidth="1920.0" fitHeight="1080.0" preserveRatio="false">
        <image>
            <Image url="@../resource/images/wood.jpg" />
        </image>
    </ImageView>

    <!-- Central layout -->
    <VBox alignment="CENTER" spacing="35" maxWidth="500" style="-fx-padding: 50;">
        <Text text="Choose Game Settings"
              style="-fx-font-size: 44px; -fx-font-weight: bold; -fx-fill: white;" />

        <!-- Number of players -->
        <VBox alignment="CENTER" spacing="10">
            <Text text="Number of players:" style="-fx-font-size: 20px; -fx-fill: white;" />
            <Slider fx:id="playerSlider" min="2.0" max="4.0" value="2.0"
                    majorTickUnit="1.0" minorTickCount="0"
                    showTickLabels="true" showTickMarks="true"
                    snapToTicks="true" blockIncrement="1.0"
                    maxWidth="300"/>
                    
        </VBox>

        <!-- Difficulty -->
        <VBox alignment="CENTER" spacing="10">
            <Text text="Difficulty of the game:" style="-fx-font-size: 20px; -fx-fill: white;" />
            <Slider fx:id="difficultySlider" min="1.0" max="3.0" value="1.0"
                    majorTickUnit="1.0" minorTickCount="0"
                    showTickLabels="true" showTickMarks="true"
                    snapToTicks="true" blockIncrement="1.0"
                    maxWidth="300" />
        </VBox>

        <!-- Buttons -->
        <HBox spacing="30" alignment="CENTER">
            <Button text="Validate" onAction="#switchToScene2"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 10; -fx-padding: 10 20;" />
            <Button text="Exit" onAction="#switchToScene"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 10; -fx-padding: 10 20;" />
        </HBox>
    </VBox>
</StackPane>
