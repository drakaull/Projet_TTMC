<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane prefHeight="864.0" prefWidth="1536.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.GameMenuUI">

    <!-- Background image that scales to entire window -->
    <ImageView preserveRatio="false">
	    <image>
	        <Image url="@../resource/images/wood.jpg" />
	    </image>
	</ImageView>


    <!-- Centered content -->
    <VBox alignment="CENTER" spacing="40.0">
        <Text style="-fx-font-weight: bold; -fx-fill: black;" text="How much do you rate yourself?">
         <font>
            <Font name="System Bold Italic" size="64.0" />
         </font></Text>
        
        <Button onAction="#switchToScene" prefHeight="80" prefWidth="300" style="-fx-background-color: #256d9e; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 12; -fx-border-color: black; -fx-border-radius: 12; -fx-border-width: 3;" text="Play" />
        
        <Button onAction="#switchToScene3" prefHeight="80" prefWidth="300" style="-fx-background-color: #46853f; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 12; -fx-border-color: black; -fx-border-radius: 12; -fx-border-width: 3;" text="Game rules" />
        
        <Button onAction="#handleExit" prefHeight="80" prefWidth="300" style="-fx-background-color: #bc1b2f; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 12; -fx-border-color: black; -fx-border-width: 3; -fx-border-radius: 12;" text="Exit" />
    </VBox>
</StackPane>
