<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="view.GameMenuUI" prefHeight="864.0" prefWidth="1536.0">

    <!-- Background image that scales to entire window -->
    <ImageView preserveRatio="false">
	    <image>
	        <Image url="@../resource/images/wood.jpg" />
	    </image>
	</ImageView>


    <!-- Centered content -->
    <VBox alignment="CENTER" spacing="40.0">
        <Text text="How much do you put yourself?"
              style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: black;" />
        
        <Button text="Play" onAction="#switchToScene" prefWidth="300" prefHeight="80"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 12;" />
        
        <Button text="Game rules" onAction="#switchToScene3" prefWidth="300" prefHeight="80"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 12;" />
        
        <Button text="Exit" onAction="#handleExit" prefWidth="300" prefHeight="80"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 12;" />
    </VBox>
</StackPane>
